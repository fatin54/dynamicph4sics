# DynamicsLab Environment Configuration
# Copy this file to .env.local for local overrides.
# NOTE: The platform is fully functional in offline/deterministic mode without any API keys.

# Optional: Google Gemini API Key for dynamic Socratic AI Tutor responses
# In production on Cloudflare Pages, set this under Settings > Environment variables
NEXT_PUBLIC_GEMINI_API_KEY=

# Application Base URL
NEXT_PUBLIC_SITE_URL=https://dynamicslab.pages.dev
